{
  "name": "wisuda-uninus-2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:dev": "node --env-file-if-exists=.env.local --import tsx server/src/index.ts",
    "api:build": "tsc -p server/tsconfig.json",
    "api:start": "node --env-file-if-exists=.env.local server/dist/src/index.js",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx server/scripts/migrate.ts",
    "admin:create": "node --env-file-if-exists=.env.local --import tsx server/scripts/create-user.ts",
    "db:test:start": "node server/scripts/test-db.mjs start",
    "db:test:stop": "node server/scripts/test-db.mjs stop",
    "test:api": "node --import tsx --test --test-concurrency=1 server/tests/*.test.ts",
    "local:seed": "node --env-file-if-exists=.env.local --import tsx server/scripts/seed-demo.ts",
    "local:start": "node scripts/local-start.mjs",
    "db:local:start": "node server/scripts/test-db.mjs start",
    "db:local:stop": "node server/scripts/test-db.mjs stop",
    "build:local": "next build",
    "admin:reset-2fa": "node --env-file-if-exists=.env.local --import tsx server/scripts/reset-2fa.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "lenis": "^1.3.26",
    "motion": "^14.2.0",
    "next": "16.4.0",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
