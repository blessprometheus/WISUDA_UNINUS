# Contoh konfigurasi. SALIN ke .env.local (lokal) atau environment server. JANGAN isi nilai rahasia di berkas ini.
# Aplikasi web (Next.js) R1 tidak membutuhkan variabel apa pun; variabel berikut untuk API (server/).

NODE_ENV=development

# Origin publik situs (tanpa path). Produksi wajib https.
APP_ORIGIN=http://127.0.0.1:3000

API_HOST=127.0.0.1
API_PORT=3001

# Koneksi PostgreSQL. Gunakan akun aplikasi dengan hak minimum, bukan superuser.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/NAMA_DB

# Tiga rahasia di bawah WAJIB acak, minimal 32 karakter, dan SALING BERBEDA.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARS
DOWNLOAD_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARS
AUDIT_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARS

# Kunci AES-256 untuk rahasia 2FA: tepat 32 byte (64 karakter heksadesimal). Hilang = 2FA semua akun tidak bisa dipakai.
TOTP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# Isi 1 HANYA bila API berada di belakang reverse proxy tepercaya (Nginx); memengaruhi pembatasan per IP.
# TRUST_PROXY=1

# --- Frontend (Next.js) ---
# Saklar fitur "Cari NIM & unduh QR". Dibaca saat BUILD. Kosong/0 = mati (R1 tidak berubah).
# NEXT_PUBLIC_QR_ENABLED=1
# Alamat API untuk rewrites /api/* (default http://127.0.0.1:3001).
# API_INTERNAL_URL=http://127.0.0.1:3001
